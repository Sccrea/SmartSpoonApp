# 复制为 .env 后填入真实值（.env 已被 .gitignore 忽略，不要提交）
# 百度 AI 开放平台的密钥：https://console.bce.baidu.com/ai/  → 图像识别 → 应用列表
# 源码里不再提供默认密钥，所以不填这两项时「拍照识别菜品」会报未配置。
BAIDU_API_KEY=your_baidu_api_key
BAIDU_SECRET_KEY=your_baidu_secret_key

# 识别返回的候选数量（1-10）
DISH_TOP_NUM=5

# 服务监听
HOST=127.0.0.1
PORT=5000
FLASK_CONFIG=dev
