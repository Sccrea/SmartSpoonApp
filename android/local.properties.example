# 复制本文件为 local.properties（去掉 .example 后缀），再把 sdk.dir 改成本机的 Android SDK 路径。
#
#   copy local.properties.example local.properties      # Windows
#   cp   local.properties.example local.properties      # macOS / Linux
#
# 也可以用正斜杠或转义反斜杠，两种写法 Android Gradle Plugin 都认：
#   sdk.dir=C:/Users/you/AppData/Local/Android/Sdk
#   sdk.dir=C\:\\Users\\you\\AppData\\Local\\Android\\Sdk
#
# 不想建这个文件的话，改为设置环境变量 ANDROID_HOME（或 ANDROID_SDK_ROOT）也一样。
#
# 注意：local.properties 记录的是**本机路径**，已在 .gitignore 里排除，不会被提交。

sdk.dir=C:/Users/you/AppData/Local/Android/Sdk
